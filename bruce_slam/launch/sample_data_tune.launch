<launch>
    <!-- Launch de CAMPAGNE pour sample_data : mêmes nœuds que slam.launch en mode offline,
         mais les paramètres à balayer sont exposés en args. slam.launch et
         sample_data.launch restent intacts : ils servent de référence reproductible.
         Les défauts ci-dessous reproduisent EXACTEMENT slam.yaml / feature.yaml, de sorte
         qu'un run sans argument est le témoin de la campagne. -->
    <arg name="bag_file" default="$(find bruce_slam)/../sample_data.bag"/>

    <!-- back-end -->
    <arg name="min_pcm" default="2"/>
    <arg name="pcm_queue_size" default="5"/>
    <arg name="keyframe_translation" default="3.0"/>
    <!-- scan matching -->
    <arg name="ssm_target_frames" default="3"/>
    <arg name="nssm_source_frames" default="5"/>
    <arg name="nssm_min_st_sep" default="8"/>
    <arg name="nssm_cov_samples" default="30"/>
    <arg name="icp_odom_sigmas" default="[0.1, 0.1, 0.01]"/>
    <!-- extraction de features -->
    <arg name="cfar_threshold" default="65"/>
    <arg name="point_resolution" default="0.5"/>

    <group ns="bruce">
        <group ns="slam">
            <rosparam command="load" file="$(find bruce_slam)/config/dead_reckoning.yaml" ns="localization"/>
            <rosparam command="load" file="$(find bruce_slam)/config/feature.yaml" ns="feature_extraction"/>
            <rosparam command="load" file="$(find bruce_slam)/config/gyro.yaml" ns="gyro"/>
            <param name="feature_extraction/filter/threshold" value="$(arg cfar_threshold)"/>

            <node pkg="bruce_slam" name="slam" type="slam_node.py" output="screen"
                  args="--file $(arg bag_file)" required="true">
                <rosparam command="load" file="$(find bruce_slam)/config/slam.yaml" subst_value="true"/>
                <param name="enable_slam" value="true"/>
                <param name="min_pcm" value="$(arg min_pcm)"/>
                <param name="pcm_queue_size" value="$(arg pcm_queue_size)"/>
                <param name="keyframe_translation" value="$(arg keyframe_translation)"/>
                <param name="point_resolution" value="$(arg point_resolution)"/>
                <param name="ssm/target_frames" value="$(arg ssm_target_frames)"/>
                <param name="nssm/source_frames" value="$(arg nssm_source_frames)"/>
                <param name="nssm/min_st_sep" value="$(arg nssm_min_st_sep)"/>
                <param name="nssm/cov_samples" value="$(arg nssm_cov_samples)"/>
                <rosparam param="icp_odom_sigmas" subst_value="true">$(arg icp_odom_sigmas)</rosparam>
            </node>
        </group>
    </group>
</launch>
