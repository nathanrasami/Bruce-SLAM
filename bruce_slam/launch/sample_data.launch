<launch>
    <!-- Bruce-SLAM PRISTINE sur son bag d'origine (sample_data.bag).
         Ce bag contient exactement les 4 topics attendus par le code original
         (/vn100/imu/raw, /rti/body_velocity/raw, /bar30/depth/raw,
         /sonar_oculus_node/ping) : aucun bridge, contrairement à Aracati.
         On enveloppe slam.launch (fichier ORIGINAL, non modifié) en mode offline :
         slam_node lit le bag lui-même et pilote les callbacks IMU/DVL/depth/sonar.
         kill:=true → roslaunch s'arrête en fin de bag, ce qui déclenche export_csv. -->
    <arg name="bag_file" default="$(find bruce_slam)/../sample_data.bag"/>
    <arg name="rviz" default="false"/>
    <arg name="enable_slam" default="true"/>
    <arg name="start" default="0.0"/>
    <arg name="duration" default="-1"/>

    <include file="$(find bruce_slam)/launch/slam.launch">
        <arg name="file" value="$(arg bag_file)"/>
        <arg name="rviz" value="$(arg rviz)"/>
        <arg name="enable_slam" value="$(arg enable_slam)"/>
        <arg name="start" value="$(arg start)"/>
        <arg name="duration" value="$(arg duration)"/>
        <arg name="kill" value="true"/>
    </include>
</launch>
